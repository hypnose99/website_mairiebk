{
  "kind": "collectionType",
  "collectionName": "actualites",
  "info": {
    "singularName": "actualite",
    "pluralName": "actualites",
    "displayName": "Actualite"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "blocks"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "urbanisme",
        "economie",
        "education",
        "culture",
        "sante"
      ]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "auteur": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "excerpt": {
      "type": "text"
    },
    "videoUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean"
    },
    "views": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "likes": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "coverImageUrl": {
      "type": "string"
    }
  }
}
