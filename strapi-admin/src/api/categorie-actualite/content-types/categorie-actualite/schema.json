{
  "kind": "collectionType",
  "collectionName": "categorie_actualites",
  "info": {
    "singularName": "categorie-actualite",
    "pluralName": "categorie-actualites",
    "displayName": "Categorie (Actualite)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nom": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "couleur": {
      "type": "string",
      "required": true,
      "default": "#009640",
      "regex": "^#([0-9A-Fa-f]{3}){1,2}$"
    },
    "actualites": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::actualite.actualite",
      "mappedBy": "categorie"
    }
  }
}
