# ─── Variables d'environnement — Mairie de Bouaké ───────────────────────────
# Copier ce fichier en .env et remplir les valeurs avant de démarrer.

# URL publique du site (utilisée pour les meta OG, le sitemap, etc.)
SITE_URL=https://mairie-bouake.ci

# Base URL de l'API (en prod : URL absolue de votre backend)
API_BASE=/api

# Clé secrète pour les routes API sécurisées (serveur uniquement)
API_SECRET_KEY=changez_cette_valeur_en_production

# ID de tracking analytics (optionnel — Google Analytics, Matomo, etc.)
ANALYTICS_ID=

# Environnement (development | staging | production)
NODE_ENV=development
