# ─── Variables d'environnement — site Mairie de Bouaké (Nuxt) ───────────────
# Copier ce fichier en .env et remplir les valeurs avant de démarrer.

# ── Strapi (obligatoire) ────────────────────────────────────────────────────
# URL du CMS : http://localhost:1337 en local, URL Render en production
STRAPI_URL=http://localhost:1337
# Jeton API Strapi (Settings → API Tokens). Droits nécessaires :
#   Actualite: find, findOne, incrementView, incrementLike, decrementLike
#   Categorie-actualite: find · Commentaire: find, create
#   Evenement: find · Projet: find, findOne
STRAPI_TOKEN=

# ── Site public ─────────────────────────────────────────────────────────────
# Adresse officielle du site : liens canoniques, partage social, sitemap.xml
SITE_URL=https://www.mairiedebouake.ci

# ── Mesure d'audience et référencement (facultatif) ─────────────────────────
# Balise Google / Analytics 4 : laisser vide en développement
GOOGLE_TAG_ID=
# Code de validation Google Search Console (méthode « balise HTML »),
# inutile si la validation se fait par la balise Google ou par le DNS
GOOGLE_SITE_VERIFICATION=

# Environnement (development | production)
NODE_ENV=development
